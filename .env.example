# Copy to .env. The UI demo works without the API, Docker, or Kick credentials.
NODE_ENV=development
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
API_INTERNAL_URL=http://localhost:4000/v1
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
PORT=4000
DATABASE_URL=postgresql://clipstage:clipstage@localhost:5432/clipstage?schema=public
# Generate: openssl rand -hex 32. Required by the API; use a different key in production.
TOKEN_ENCRYPTION_KEY=change-me-to-64-hex-characters
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:4000/v1/auth/kick/callback
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clipstage
S3_ACCESS_KEY_ID=clipstage
S3_SECRET_ACCESS_KEY=clipstage-local-secret
S3_FORCE_PATH_STYLE=true
# Maximum individual source file: 2 GiB. Streaming direct uploads never pass through Nest.
MAX_UPLOAD_BYTES=2147483648
