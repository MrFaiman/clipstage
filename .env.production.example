# Copy to .env.production (ignored by git). Pass it to Compose with --env-file.
# DNS must point PUBLIC_HOST to this server; no scheme, port, or trailing slash.
PUBLIC_HOST=clipstage.example.com
# External PostgreSQL: use TLS and a least-privilege application account.
DATABASE_URL=postgresql://user:password@db.example.com:5432/clipstage?schema=public&sslmode=require
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Configure a private bucket and its browser upload/playback CORS separately.
S3_REGION=us-east-1
S3_BUCKET=clipstage-production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# For non-AWS S3, set a publicly reachable HTTPS endpoint for presigned browser/OBS URLs:
# S3_ENDPOINT=https://s3.example.com
MAX_UPLOAD_BYTES=2147483648
