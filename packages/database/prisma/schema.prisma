generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  KICK
  TWITCH
  YOUTUBE
}

enum Role {
  OWNER
  EDITOR
}

enum ClipStatus {
  UPLOADING
  INBOX
  EDITING
  IN_REVIEW
  APPROVED
}

model User {
  id            String         @id @default(cuid())
  name          String
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  accounts      OAuthAccount[]
  sessions      Session[]
  memberships   Membership[]
  uploads       Clip[]         @relation("Uploader")
  assignments   Clip[]         @relation("Assignee")
  oauthAttempts OAuthAttempt[]
  devices       Device[]
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       Provider
  providerUserId String
  username       String
  email          String?
  accessToken    String // AES-256-GCM encrypted; never returned by the API
  refreshToken   String?
  expiresAt      DateTime
  scopes         String[]
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
}

model OAuthAttempt {
  stateHash String   @id
  verifier  String
  userId    String?
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  logoKey     String?
  createdAt   DateTime     @default(now())
  members     Membership[]
  clips       Clip[]
  invitations Invitation[]
  devices     Device[]
}

model Membership {
  workspaceId String
  userId      String
  role        Role      @default(EDITOR)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String?
  username    String?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@unique([workspaceId, username])
  @@index([workspaceId])
}

model Device {
  id          String    @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  clips       Clip[]

  @@index([workspaceId])
}

model Clip {
  id              String     @id @default(cuid())
  workspaceId     String
  uploadedById    String
  deviceId        String?
  clientUploadId  String
  title           String
  brief           String     @default("")
  status          ClipStatus @default(UPLOADING)
  provider        Provider   @default(KICK)
  fileName        String
  mimeType        String
  sizeBytes       BigInt
  storageKey      String     @unique
  multipartId     String?    // Private S3 upload ID; never sent to clients.
  durationSeconds Float?
  trimStart       Float?
  trimEnd         Float?
  project         Json?
  assigneeId      String?
  version         Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy      User       @relation("Uploader", fields: [uploadedById], references: [id])
  assignee        User?      @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  device          Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, clientUploadId])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, status])
}
