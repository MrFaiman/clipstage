{
  "name": "clipstage",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "storage:init": "bun --env-file=.env apps/api/src/storage-init.ts",
    "test:integration": "RUN_INTEGRATION=1 bun --env-file=.env test apps/api/test/integration.test.ts",
    "test:e2e": "bunx playwright test",
    "test:live": "RUN_INTEGRATION=1 RUN_LIVE_E2E=1 bun --env-file=.env test apps/api/test/integration.test.ts",
    "dev": "concurrently -k -n api,web -c cyan,green 'bun run dev:api' 'bun run dev:web'",
    "dev:api": "bun --env-file=.env --watch apps/api/src/main.ts",
    "dev:web": "bun --env-file=.env run --filter @clipstage/web dev",
    "build": "bun run --filter @clipstage/api build && bun run --filter @clipstage/web build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit",
    "test": "bun test packages/contracts/src apps/api/test apps/web/src/lib/resilient-upload.test.ts apps/web/src/lib/multipart-upload.test.ts apps/web/src/lib/session-label.test.ts",
    "check": "bun run typecheck && bun run test",
    "format": "prettier --write .",
    "db:generate": "bun --env-file=.env run --filter @clipstage/database generate",
    "db:migrate": "bun --env-file=.env run --filter @clipstage/database migrate",
    "db:deploy": "bun --env-file=.env run --filter @clipstage/database deploy",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.15.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
